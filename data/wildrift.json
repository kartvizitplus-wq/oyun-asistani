          {
            "n": "Draven",
            "w": {
              "en": "His axes win the early trades and punish Tristana while she is still stacking Explosive Charge.",
              "tr": "Baltalarıyla erken oyundaki değişimleri kazanır ve Tristana Explosive Charge yüklerini biriktirirken onu cezalandırır.",
              "id": "Kapaknya memenangkan trade di early game dan menghukum Tristana saat ia masih menumpuk Explosive Charge.",
              "es": "Sus hachas ganan los primeros intercambios y castigan a Tristana mientras aún acumula Explosive Charge.",
              "pt": "Os machados vencem as primeiras trocas e punem Tristana enquanto ela ainda acumula Explosive Charge."
            }
          },
          {
            "n": "Caitlyn",
            "w": {
              "en": "Longer early range and traps let her zone Tristana and punish her for pushing the wave before Tristana's range grows.",
              "tr": "Erken oyunda daha uzun menzili ve tuzaklarıyla Tristana'yı alandan uzak tutar, menzili büyümeden minyon dalgasını ittiği için onu cezalandırır.",
              "id": "Jangkauan awal yang lebih jauh dan jebakan membuatnya bisa mengusir Tristana dan menghukumnya saat push wave sebelum jangkauan Tristana bertambah.",
              "es": "Su mayor alcance inicial y sus trampas le permiten alejar a Tristana y castigarla por empujar la oleada antes de que su alcance crezca.",
              "pt": "O alcance inicial maior e as armadilhas permitem afastar Tristana e puni-la por empurrar a wave antes que o alcance dela cresça."
            }
          },
          {
            "n": "Xayah",
            "w": {
              "en": "Featherstorm makes her untargetable during Tristana's bomb, and her recalled feathers can root Tristana right after a Rocket Jump.",
              "tr": "Featherstorm sırasında hedef alınamaz hale gelip Tristana'nın bombasından kurtulur. Geri çağırdığı tüyler, Rocket Jump'tan hemen sonra Tristana'yı köklendirebilir.",
              "id": "Featherstorm membuatnya tidak bisa ditarget saat bom Tristana, dan bulu yang ia tarik kembali bisa me-root Tristana tepat setelah Rocket Jump.",
              "es": "Featherstorm la vuelve inalcanzable durante la bomba de Tristana, y sus plumas al volver pueden enraizarla justo después de un Rocket Jump.",
              "pt": "Featherstorm a deixa inalvejável durante a bomba de Tristana, e as penas ao voltar podem enraizar Tristana logo após um Rocket Jump."
            }
          },
          {
            "n": "Nautilus",
            "w": {
              "en": "Punishes Tristana's predictable Rocket Jumps with hook, root and ultimate before she can reset her jump.",
              "tr": "Tristana'nın tahmin edilebilir Rocket Jump'larını, zıplaması yenilenmeden kanca, köklendirme ve ultisiyle cezalandırır.",
              "id": "Menghukum Rocket Jump Tristana yang mudah ditebak dengan hook, root, dan ultimate sebelum ia bisa me-reset lompatannya.",
              "es": "Castiga los Rocket Jump predecibles de Tristana con gancho, enraizamiento y definitiva antes de que pueda reiniciar el salto.",
              "pt": "Pune os Rocket Jumps previsíveis de Tristana com gancho, raiz e ultimate antes que ela consiga reiniciar o salto."
            }
          }
        ],
        "tip": {
          "en": "Tristana is weakest before her first item and whenever Rocket Jump is on cooldown. Bait the jump first, then trade, and save your crowd control for the moment she lands.",
          "tr": "Tristana ilk itemini almadan önce ve Rocket Jump bekleme süresindeyken en zayıf halindedir. Önce zıplamasını harcatın, sonra saldırın; kitle kontrolünüzü yere indiği an için saklayın.",
          "id": "Tristana paling lemah sebelum item pertamanya dan saat Rocket Jump sedang cooldown. Pancing lompatannya dulu, lalu trade, dan simpan crowd control untuk saat ia mendarat.",
          "es": "Tristana es más débil antes de su primer objeto y cuando Rocket Jump está en enfriamiento. Provoca el salto primero, luego intercambia, y guarda tu control para cuando aterrice.",
          "pt": "Tristana é mais fraca antes do primeiro item e quando o Rocket Jump está em recarga. Force o salto primeiro, depois troque, e guarde o controle de grupo para quando ela pousar."
        }
